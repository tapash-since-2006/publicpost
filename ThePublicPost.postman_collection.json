    {
      "name": "5 - Articles",
      "item": [
        {
          "name": "Create and Submit Article",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.article && res.article.id) {",
                  "  pm.collectionVariables.set('articleId', res.article.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{journalist_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Breaking: Economy Update 2026",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "The economy is showing strong signs of recovery with GDP growth of 3.2 percent in Q1 2026. Experts predict continued growth throughout the year.",
                  "type": "text"
                },
                {
                  "key": "tags[]",
                  "value": "economy",
                  "type": "text"
                },
                {
                  "key": "tags[]",
                  "value": "politics",
                  "type": "text"
                },
                {
                  "key": "submit",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base}}/articles",
              "host": [
                "{{base}}"
              ],
              "path": [
                "articles"
              ]
            }
          }
        },
