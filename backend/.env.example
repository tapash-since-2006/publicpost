# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8012
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Database (Neon or any PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:your_password@your-neon-host.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Redis (Docker handles this — don't change unless using external Redis) ──
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ─── Cloudinary (optional — only needed for image/file uploads) ───────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
